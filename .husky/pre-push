# The same turbo cache miss pre-commit documents.
unset GIT_DIR

# A markdown-only push has nothing here that can fail: no test, clippy run or
# e2e spec reads a committed .md. Without this, fixing a typo in a doc costs the
# full Rust workspace and a tier-1 e2e run.
#
# @{u}..HEAD is what is about to leave the machine. A branch with no upstream
# has no range to compute, so it runs everything rather than guessing.
if git rev-parse --verify -q '@{u}' >/dev/null 2>&1; then
  pushing=$(git diff --name-only '@{u}..HEAD')
  if [ -n "$pushing" ] && ! printf '%s\n' "$pushing" | grep -qvE '(\.md|\.txt|LICENSE)$'; then
    DIFF_BASE='@{u}..HEAD' ./scripts/verify.sh || exit 1
    printf '\033[0;32m✓\033[0m Docs-only push — code gates skipped\n'
    exit 0
  fi
fi

# The same reasoning, one level finer: a gate runs only when the push touches something it reads.
# These are dependencies, not guesses, so a skip never hides a failure the gate could have found.
#
# The Rust gates go a level finer again: scripts/rust-affected.mjs names the crates the push
# changes plus every crate that uses them, from Cargo's own graph and the files tests read across
# crate boundaries. A change to pikos-cli tests pikos-cli; one to pikos-db still tests everything
# built on it. CI runs every crate on every pull request, which is what makes a local slice safe.
# The mock e2e lane runs the web app on the mock adapter, so it reads nothing Rust builds. With no
# upstream, `pushing` is empty and everything runs.
rust_crates=all
rust_desktop=1
rust_swift=1
rust_bridge=1
rust_summary="Rust gates: every crate, because the branch has no upstream to compare with"
smoke_needed=1
if [ -n "$pushing" ]; then
  slice=$(printf '%s\n' "$pushing" | node scripts/rust-affected.mjs) || {
    slice=""
    rust_summary="Rust gates: every crate, because the slice above failed to compute"
  }
  while IFS="$(printf '\t')" read -r key value; do
    case "$key" in
      crates) rust_crates=$value ;;
      desktop) rust_desktop=$value ;;
      swift) rust_swift=$value ;;
      bridge) rust_bridge=$value ;;
      summary) rust_summary=$value ;;
    esac
  done <<EOF_SLICE
$slice
EOF_SLICE
  rust_only='^(crates/|apps/desktop/src-tauri/|Cargo\.(toml|lock)$|\.cargo/)'
  printf '%s\n' "$pushing" | grep -vE '(\.md|\.txt|LICENSE)$' | grep -qvE "$rust_only" || smoke_needed=0
fi

# Full unit suite. Pre-commit runs it too, through turbo's cache, so this usually
# replays it for free; it is here for a push whose commits skipped the hook.
echo "Running unit tests (full suite)..."
pnpm exec turbo test || exit 1
printf '\033[0;32m✓\033[0m Unit tests — full suite\n'

# Rust lint + tests — too slow for pre-commit, fine for pre-push.
#
# Two Cargo trees, and both need covering: the root workspace is `crates/*` and it *excludes*
# the Tauri crate, so `--all` inside apps/desktop/src-tauri covers that one crate alone.
if [ -z "$rust_crates" ] && [ "$rust_desktop" = 0 ] && [ "$rust_swift" = 0 ]; then
  printf '\033[0;32m✓\033[0m %s\n' "$rust_summary"
elif command -v cargo &>/dev/null; then
  printf '\033[0;32m✓\033[0m %s\n' "$rust_summary"

  echo "Checking Rust formatting..."
  cargo fmt --all --check || exit 1
  if [ -f apps/desktop/src-tauri/Cargo.toml ]; then
    cargo fmt --check --manifest-path apps/desktop/src-tauri/Cargo.toml || exit 1
  fi
  printf '\033[0;32m✓\033[0m Rust formatting\n'

  if [ -n "$rust_crates" ]; then
    # Husky runs this with sh, so a word list rather than an array. Crate names hold no spaces.
    if [ "$rust_crates" = all ]; then
      packages=--workspace
      label=workspace
    else
      packages=""
      for crate in $rust_crates; do packages="$packages -p $crate"; done
      label=$rust_crates
    fi

    echo "Running cargo clippy ($label)..."
    cargo clippy $packages --all-targets --quiet -- -D warnings || exit 1
    printf '\033[0;32m✓\033[0m Rust clippy — crates\n'

    # pikos-cli's parser tests skip themselves when the bridge bundle is missing,
    # and read a stale one when it is out of date — build it so they mean something.
    if [ "$rust_bridge" = 1 ]; then
      pnpm --filter @pikos/bridge build >/dev/null || exit 1
    fi

    echo "Running cargo test ($label)..."
    cargo test $packages --quiet || exit 1
    printf '\033[0;32m✓\033[0m Rust tests — crates\n'
  fi

  # CI runs the same check, but only on a push to main or a PR into it, and a
  # feature branch can go days without either while a local phone build from the
  # stale Swift traps at launch.
  if [ "$rust_swift" = 1 ]; then
    echo "Checking Swift bindings..."
    bash scripts/gen-swift-bindings.sh >/dev/null || exit 1
    git diff --exit-code --quiet -- apps/ios/PikosCore/Sources apps/ios/PikosCore/generated \
      || { echo "Swift bindings are stale; commit the regenerated files"; exit 1; }
    printf '\033[0;32m✓\033[0m Swift bindings\n'
  fi

  if [ "$rust_desktop" = 1 ] && [ -f apps/desktop/src-tauri/Cargo.toml ]; then
    echo "Running cargo clippy (desktop)..."
    (cd apps/desktop/src-tauri && cargo clippy --all-targets --quiet -- -D warnings) || exit 1
    printf '\033[0;32m✓\033[0m Rust clippy — desktop\n'

    echo "Running cargo test (desktop)..."
    (cd apps/desktop/src-tauri && cargo test --quiet) || exit 1
    printf '\033[0;32m✓\033[0m Rust tests — desktop\n'
  fi
fi

# The @smoke e2e tests, on the mock so no Rust build stands in the way — skip when
# SKIP_E2E is set. The full suite and perf run in CI.
if [ "$smoke_needed" = 0 ]; then
  printf '\033[0;32m✓\033[0m E2E smoke skipped — the push is Rust only, and the mock lane runs none\n'
elif [ -z "$SKIP_E2E" ]; then
  pnpm --filter @pikos/desktop test:e2e --project e2e --grep @smoke -x
fi
