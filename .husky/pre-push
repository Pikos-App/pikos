# Full unit suite. Pre-commit runs only the specs its diff reaches, so this is the
# first gate seeing all of them — what keeps commits fast without letting an
# unreached breakage leave the machine. Turbo-cached, so usually ~free.
echo "Running unit tests (full suite)..."
pnpm exec turbo test || exit 1
printf '\033[0;32m✓\033[0m Unit tests — full suite\n'

# Rust lint + tests — too slow for pre-commit (~15s), fine for pre-push.
#
# Two Cargo trees, and both need covering: the root workspace is `crates/*`
# (pikos-db, pikos-cli, pikos-calendar-sync) and it *excludes* the Tauri crate,
# so a check that runs only in apps/desktop/src-tauri leaves the DB and sync
# crates ungated entirely.
if command -v cargo &>/dev/null; then
  echo "Checking Rust formatting..."
  cargo fmt --all --check || exit 1
  if [ -f apps/desktop/src-tauri/Cargo.toml ]; then
    cargo fmt --check --manifest-path apps/desktop/src-tauri/Cargo.toml || exit 1
  fi
  printf '\033[0;32m✓\033[0m Rust formatting\n'

  echo "Running cargo clippy (workspace)..."
  cargo clippy --workspace --all-targets --quiet -- -D warnings || exit 1
  printf '\033[0;32m✓\033[0m Rust clippy — crates\n'

  # pikos-cli's parser tests skip themselves when the bridge bundle is missing,
  # and read a stale one when it is out of date — build it so they mean something.
  pnpm --filter @pikos/bridge build >/dev/null || exit 1

  echo "Running cargo test (workspace)..."
  cargo test --workspace --quiet || exit 1
  printf '\033[0;32m✓\033[0m Rust tests — crates\n'

  if [ -f apps/desktop/src-tauri/Cargo.toml ]; then
    echo "Running cargo clippy (desktop)..."
    (cd apps/desktop/src-tauri && cargo clippy --all-targets --quiet -- -D warnings) || exit 1
    printf '\033[0;32m✓\033[0m Rust clippy — desktop\n'

    echo "Running cargo test (desktop)..."
    (cd apps/desktop/src-tauri && cargo test --quiet) || exit 1
    printf '\033[0;32m✓\033[0m Rust tests — desktop\n'
  fi
fi

# Tier 1 E2E smoke — skip when SKIP_E2E is set. Tier 2 + perf run in CI.
if [ -z "$SKIP_E2E" ]; then
  pnpm --filter @pikos/desktop test:e2e --project tier1 -x
fi
