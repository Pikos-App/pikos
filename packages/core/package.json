{
  "name": "@pikos/core",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:parity": "esbuild scripts/gen-parity-corpus.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen-parity.mjs && TZ=UTC node node_modules/.cache/gen-parity.mjs",
    "measure:parser-grammar": "esbuild scripts/parser-grammar/measure.ts --bundle --platform=node --format=esm --alias:chrono-node=./scripts/parser-grammar/chrono-recorder.ts --outfile=node_modules/.cache/measure-parser-grammar.mjs && TZ=UTC node node_modules/.cache/measure-parser-grammar.mjs",
    "gen:date-corpus": "esbuild scripts/parser-grammar/date-corpus.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/date-corpus.mjs && TZ=UTC node node_modules/.cache/date-corpus.mjs",
    "gen:date-calls": "esbuild scripts/parser-grammar/call-corpus.ts --bundle --platform=node --format=esm --alias:chrono-node=./scripts/parser-grammar/chrono-recorder.ts --outfile=node_modules/.cache/date-calls.mjs && TZ=UTC node node_modules/.cache/date-calls.mjs",
    "probe:chrono": "esbuild scripts/parser-grammar/probe.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/probe-chrono.mjs && TZ=UTC node node_modules/.cache/probe-chrono.mjs",
    "probe:parser": "esbuild scripts/parser-grammar/probe-parser.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/probe-parser.mjs && TZ=UTC node node_modules/.cache/probe-parser.mjs",
    "probe:snap": "esbuild scripts/parser-grammar/probe-snap.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/probe-snap.mjs && TZ=UTC node node_modules/.cache/probe-snap.mjs",
    "gen:fuzz": "esbuild scripts/parser-grammar/fuzz.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fuzz.mjs && TZ=UTC node node_modules/.cache/fuzz.mjs",
    "gen:fuzz-recurrence": "esbuild scripts/parser-grammar/fuzz-recurrence.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fuzz-recurrence.mjs && TZ=UTC node node_modules/.cache/fuzz-recurrence.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "chrono-node": "^2.9.0",
    "date-fns": "^4.1.0",
    "rrule": "^2.8.1"
  }
}
