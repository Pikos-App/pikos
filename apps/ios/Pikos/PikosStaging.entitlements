<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pikos.entitlements with the staging app's own App Group and iCloud container, so a dogfood build
  never touches the real workspace. Pikos.entitlements says why aps-environment reads development.
  The iCloud environment comes from PIKOS_CLOUDKIT_ENVIRONMENT in project.yml.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.pikos.staging</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.pikos.staging</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>$(PIKOS_CLOUDKIT_ENVIRONMENT)</string>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
