    },
    "Pages from a calendar stay here until they're deleted in the calendar." : {

    },
    "Pages scheduled for today appear here. Type a sentence and Pikos reads the date, time, priority and tags out of it." : {

    },
    "Pages scheduled in the next week will appear here." : {

    },
