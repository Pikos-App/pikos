---
import { getCollection, render } from "astro:content";

import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { formatDate } from "../content/posts";
import { isOut, publishedVersion } from "../content/published";

const released = await publishedVersion();
const entries = (await getCollection("releaseNotes"))
  .filter((entry) => isOut(entry.id, released))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const releases = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const isoDate = entry.data.date.toISOString().slice(0, 10);

    return { Content, badge: entry.data.badge, isoDate, version: entry.id };
  }),
);
---

<Base title="Release notes - Pikos" description="What's new in Pikos. A running log of features, fixes, and improvements.">

  <main class="mx-auto max-w-2xl px-8 py-20">

    <!-- Back to home -->
    <a href="/" class="inline-flex items-center gap-1 text-sm text-neutral-400 transition-colors hover:text-primary-500 dark:text-neutral-500 dark:hover:text-primary-400">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Home
    </a>

    <h1 class="mt-8 text-4xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50">Release notes</h1>
    <p class="mt-3 text-sm text-neutral-400 dark:text-neutral-500">What ships in each release.</p>

    <div class="mt-12 space-y-16">
      {releases.map(({ Content, badge, isoDate, version }) => (
        <article>
          <div class="flex items-center gap-3">
            <h2 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-50">{version}</h2>
            {badge && (
              <span class="rounded-full bg-warning-400/15 px-2.5 py-0.5 text-xs font-medium text-warning-600 dark:bg-warning-500/20 dark:text-warning-400">{badge}</span>
            )}
          </div>
          <time class="mt-1 block text-sm text-neutral-400 dark:text-neutral-500" datetime={isoDate}>{formatDate(isoDate)}</time>

          <div class="notes mt-6 space-y-6 text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
            <Content />
          </div>
        </article>
      ))}
    </div>

  </main>

  <Footer />
</Base>

<style>

  .notes :global(h3) {
    padding-top: 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-neutral-900);
  }
  :global(html.dark) .notes :global(h3) {
    color: var(--color-neutral-50);
  }

  .notes :global(ul) {
    padding-left: 1.25rem;
    list-style-type: disc;
  }

  .notes :global(li + li) {
    margin-top: 0.375rem;
  }

  .notes :global(a) {
    color: var(--color-primary-500);
  }
  :global(html.dark) .notes :global(a) {
    color: var(--color-primary-400);
  }
  .notes :global(a:hover) {
    text-decoration: underline;
  }

  .notes :global(code) {
    border-radius: 0.25rem;
    background-color: var(--color-neutral-100);
    padding: 0.125rem 0.375rem;
    font-size: 0.875rem;
  }
  :global(html.dark) .notes :global(code) {
    background-color: var(--color-neutral-800);
  }
</style>
