---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import SpeedBars from "../components/SpeedBars.astro";
import SpeedTable from "../components/SpeedTable.astro";
import { type Op, type Series, fmtPages, fmtTime } from "../lib/speed";
import app from "../data/app.json";

const title = "Pikos speed: fast with 50 pages, fast with 500,000";
const description =
  "Opening a page, searching, switching views, completing a task, and paging through the calendar, timed in the app itself, from fifty pages to half a million. Measured on a laptop, with the details and the commands to check it.";

// ── The app, as a person uses it ─────────────────────────────────────────────────────────────
type AppSize = { seeded: number; [action: string]: unknown };
const appSizes = app.sizes as AppSize[];
const appSeries = (key: string, label: string, button: string, heading: string): Series => ({
  key,
  label,
  button,
  heading,
  values: appSizes.map((s) => (s[key] as Op | null) ?? null),
});
const appActions: Series[] = [
  appSeries("openDirect", "Open a page", "Open", "Click until the page is drawn"),
  appSeries("search", "Search", "Search", "Typing until results show"),
  appSeries("switchView", "Switch views", "Switch", "Click until the list is drawn"),
  appSeries("complete", "Complete a task", "Complete", "Click until it shows done"),
  appSeries("rename", "Rename a page", "Rename", "Typing until it's renamed"),
  appSeries("weekCold", "Next week", "Calendar", "Click until the week is drawn"),
  appSeries("launch", "Launch", "Launch", "Start until it's ready to use"),
];
const largestPages = Math.max(...appSizes.map((s) => s.seeded));
const atLargest = (key: string) => appActions.find((a) => a.key === key)?.values.at(-1) ?? null;
const headline = [
  { key: "openDirect", label: "to open a page" },
  { key: "search", label: "to search" },
  { key: "switchView", label: "to switch views" },
];
const yearsAtTenADay = Math.round(largestPages / 10 / 365);

const measuredOn = (date: string) =>
  new Date(`${date}T12:00:00Z`).toLocaleDateString("en-US", { day: "numeric", month: "long", year: "numeric" });

const benchCommands = `brew install pikos-app/tap/pikos-cli
pikos stress seed --db ~/pikos-bench.db --pages 500000
pikos stress bench --db ~/pikos-bench.db --runs 20`;
const code = "rounded bg-neutral-100 px-1 py-0.5 text-xs dark:bg-neutral-800";
const link = "font-medium text-primary-500 hover:underline dark:text-primary-400";
const bullet = "flex items-start gap-2";
---

<Base title={title} description={description}>

  <main class="relative mx-auto max-w-4xl px-8 py-20">

    <!-- Hero -->
    <h1 class="text-5xl font-bold leading-tight tracking-tight text-neutral-900 sm:text-6xl dark:text-neutral-50">
      Fast with 50 pages.<br />
      <span class="text-brand-500 dark:text-brand-400">Fast with {fmtPages(largestPages)}.</span>
    </h1>
    <p class="mt-6 max-w-2xl text-xl leading-relaxed text-neutral-500 dark:text-neutral-400">
      Opening a page, searching, switching views, completing a task, and paging through the calendar, timed in the app itself, from fifty pages to half a million.
    </p>

    <div class="mt-12 grid gap-4 sm:grid-cols-3">
      {headline.map((h) => {
        const v = atLargest(h.key);
        return (
          <div class="rounded-xl border border-neutral-200 bg-white px-5 py-5 dark:border-neutral-800 dark:bg-neutral-900">
            <p class="text-4xl font-bold tracking-tight text-neutral-900 tabular-nums dark:text-neutral-50">{v ? fmtTime(v.ms) : "–"}</p>
            <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">{h.label}</p>
            <p class="mt-3 text-xs text-neutral-400 dark:text-neutral-500">with {fmtPages(largestPages)} pages</p>
          </div>
        );
      })}
    </div>
    <p class="mt-4 text-xs text-neutral-400 dark:text-neutral-500">
      A millisecond (ms) is a thousandth of a second. And {fmtPages(largestPages)} pages is ten new pages a day for {yearsAtTenADay} years.
    </p>

    <!-- The bars -->
    <section class="mt-24">
      <h2 class="text-2xl font-semibold text-neutral-800 dark:text-neutral-100">Ten thousand times the pages. Still fast.</h2>
      <p class="mt-2 text-base leading-relaxed text-neutral-500 dark:text-neutral-400">
        The grey bar is how many pages are in the workspace. The green number is how long you wait. Pick an action to see it at every size.
      </p>
      <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-6 sm:p-8 dark:border-neutral-800 dark:bg-neutral-900">
        <SpeedBars sizes={appSizes.map((s) => s.seeded)} series={appActions} />
      </div>
    </section>

    <!-- Every number -->
    <section class="mt-24">
      <h2 class="text-2xl font-semibold text-neutral-800 dark:text-neutral-100">Every number</h2>
      <p class="mt-2 mb-6 text-base leading-relaxed text-neutral-500 dark:text-neutral-400">
        The table shows the median. Switch to the 99th percentile to see the time 99 tries in 100 came in under.
      </p>
      <SpeedTable sizes={appSizes.map((s) => s.seeded)} series={appActions} />
    </section>

    <!-- How the app was measured -->
    <section class="mt-24">
      <h2 class="text-2xl font-semibold text-neutral-800 dark:text-neutral-100">How these were measured</h2>
      <ul class="mt-6 space-y-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
        <li class={bullet}>
          <span class="mt-0.5 text-warning-400">→</span>
          <span>On {measuredOn(app.measured)}, on a {app.machine.model} ({app.machine.chip}, {app.machine.memory}) running {app.machine.os}, plugged in. It's an ordinary laptop with no fan, so it rested between sizes to keep heat out of the numbers.</span>
        </li>
        <li class={bullet}>
          <span class="mt-0.5 text-warning-400">→</span>
          <span>{app.build.version}, built the same way as the version you download, from commit <code class={code}>{app.build.commit}</code>, with a timer built in that the version you download doesn't have.</span>
        </li>
        <li class={bullet}>
          <span class="mt-0.5 text-warning-400">→</span>
          <span>The app was launched {app.launches} times at each size. Each launch opened 40 pages picked at random, ran 20 searches, switched between views, completed 10 tasks, renamed 10 pages, and stepped the calendar 10 weeks forward and 10 back. Every action is timed from the moment it starts to the next frame drawn after the screen shows the result, and a list or a week counts only once everything in it has loaded.</span>
        </li>
        <li class={bullet}>
          <span class="mt-0.5 text-warning-400">→</span>
          <span>The pages are generated: ordinary English words, forty to a page, from a fixed list and a fixed seed, so the same workspace can be built again anywhere.</span>
        </li>
        <li class={bullet}>
          <span class="mt-0.5 text-warning-400">→</span>
          <span>Not here yet: typing in a very long page. The editor is next, and its numbers go on this page when they're good.</span>
        </li>
      </ul>
    </section>

    <!-- Try it on your own machine -->
    <section class="mt-24 border-t border-neutral-200 pt-20 dark:border-neutral-800">
      <h2 class="text-2xl font-semibold text-neutral-800 dark:text-neutral-100">Try it on your own machine</h2>
      <p class="mt-2 text-base leading-relaxed text-neutral-500 dark:text-neutral-400">
        Your numbers will depend on your machine. Wherever you run it, half a million pages should be about as fast as two thousand.
      </p>

      <div class="mt-8 rounded-xl border border-neutral-200 bg-white px-6 py-8 sm:px-8 dark:border-neutral-800 dark:bg-neutral-900">
        <h3 class="text-xl font-semibold text-neutral-900 dark:text-neutral-50">Time the app</h3>
        <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
          The numbers above come from a build of Pikos with a timer compiled in. On a Mac, build it from <a href="https://github.com/Pikos-App/pikos" class={link}>source</a> and run <code class={code}>node apps/marketing/scripts/benchmark-app.mjs</code>. It builds the workspaces, launches the app {app.launches} times at each size, and takes about fifty minutes. <code class={code}>--quick</code> runs a shorter pass.
        </p>

        <h3 class="mt-10 text-xl font-semibold text-neutral-900 dark:text-neutral-50">Time the database</h3>
        <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
          The <a href="/cli" class={link}>Pikos CLI</a> builds the same half-million-page workspace and times the calls the app makes to it.
        </p>
        <pre class="mt-4 overflow-x-auto rounded-lg bg-neutral-100 p-4 text-sm leading-relaxed text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">{benchCommands}</pre>
        <p class="mt-4 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
          <code class={code}>seed</code> writes half a million pages into a new file, which took about four minutes on the laptop above. It won't touch the workspace your app uses, so your notes are safe. <code class={code}>bench</code> prints the median and the 95th percentile for each action, and <code class={code}>--json</code> adds the 99th. When you're done, delete <code class={code}>~/pikos-bench.db</code> and the two files beside it that end in <code class={code}>-wal</code> and <code class={code}>-shm</code>.
        </p>

        <p class="mt-8 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
          Then <a href="/feedback" class={link}>let me know how it goes</a>.
        </p>
      </div>
    </section>

  </main>

  <Footer />
</Base>

<script>
  // A switch is any element with data-switch="<name>": its buttons set data-<name> on it, and the
  // markup inside shows or hides itself from that attribute.
  for (const group of document.querySelectorAll<HTMLElement>("[data-switch]")) {
    const name = group.dataset.switch!;
    const buttons = group.querySelectorAll<HTMLButtonElement>("button[data-switch-value]");
    for (const button of buttons) {
      button.addEventListener("click", () => {
        group.dataset[name] = button.dataset.switchValue;
        for (const other of buttons) other.setAttribute("aria-pressed", String(other === button));
      });
    }
  }
</script>
