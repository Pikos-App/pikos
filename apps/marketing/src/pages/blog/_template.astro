---
/**
 * Blog post template: copy it to `my-post-slug.astro`, add the post to `posts` in
 * /src/content/posts.ts (title, description, date and tag live only there), and set `slug`
 * below to the filename without .astro. The prose area styles h2, h3, p, ul, a, code and
 * blockquote.
 */
import BlogPost from "../../layouts/BlogPost.astro";
---

<BlogPost slug="my-post-slug">

  <p>
    Write your post content here. Use standard HTML elements.
  </p>

  <h2>Section heading</h2>

  <p>
    More content.
  </p>

</BlogPost>
