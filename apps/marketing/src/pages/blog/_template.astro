---
/**
 * Blog post template — copy this file to create a new post.
 *
 * 1. Copy this file: cp _template.astro my-post-slug.astro
 * 2. Add the post to `posts` in /src/content/posts.ts — title, description, date and tag
 *    live there and nowhere else, so the listing, the page and the RSS feed cannot disagree
 * 3. Set `slug` below to the filename without .astro
 * 4. Write your content below (plain HTML, same as other pages)
 *
 * Available HTML in the prose area:
 *   <h2>, <h3>           — section headings
 *   <p>                   — paragraphs
 *   <ul><li>              — bullet lists
 *   <a href="...">        — links (auto-styled orange)
 *   <code>                — inline code
 *   <blockquote><p>       — pull quotes
 */
import BlogPost from "../../layouts/BlogPost.astro";
---

<BlogPost slug="my-post-slug">

  <p>
    Write your post content here. Use standard HTML elements.
  </p>

  <h2>Section heading</h2>

  <p>
    More content.
  </p>

</BlogPost>
