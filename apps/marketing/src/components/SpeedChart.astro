---
import { type Corpus, type Row, fmtMs, fmtPages, roundPages } from "../lib/speed";

interface Props {
  corpora: Corpus[];
  /** The flat actions, drawn together as one band. */
  rows: Row[];
  /** The action the dashed "if it slowed as it filled" line grows from. */
  growthOp: string;
  width: number;
  height: number;
  /** Unique per instance: the page draws one chart for wide screens and one for phones. */
  id: string;
  class?: string;
}

const { corpora, rows, growthOp, width: W, height: H, id, class: className } = Astro.props;
const narrow = W < 480;
const pad = { top: 28, right: narrow ? 12 : 24, bottom: 44, left: 32 };
const plotW = W - pad.left - pad.right;
const plotH = H - pad.top - pad.bottom;
const logMin = Math.log10(corpora[0].pages);
const logMax = Math.log10(corpora[corpora.length - 1].pages);
const x = (pages: number) => pad.left + ((Math.log10(pages) - logMin) / (logMax - logMin)) * plotW;
const FRAME_MS = 1000 / 60;
const yMax = 20;
const y = (ms: number) => pad.top + plotH - (Math.min(ms, yMax) / yMax) * plotH;
const fmtAxis = (n: number) => (n >= 1000 ? `${n / 1000}K` : `${n}`);

const slowest = (c: Corpus) => Math.max(...rows.map((r) => c.ops[r.op].ms));
const fastest = (c: Corpus) => Math.min(...rows.map((r) => c.ops[r.op].ms));
const bandTop = corpora.map((c) => `${x(c.pages)},${y(slowest(c))}`);
const band = [...bandTop, ...corpora.map((c) => `${x(c.pages)},${y(fastest(c))}`).reverse()].join(" ");
const bandCeiling = Math.ceil(Math.max(...corpora.map(slowest)) * 2) / 2;
const bandLabel = narrow
  ? ["Open, save, create, search:", `under ${bandCeiling} ms at every size`]
  : [`Open, save, create, search: under ${bandCeiling} ms at every size`];

// What "slows as it fills" looks like: the first time, growing in step with the pages.
const start = corpora[0].ops[growthOp].ms;
const growth = corpora.map((c) => `${x(c.pages)},${y(0) - ((start * c.pages) / corpora[0].pages / yMax) * plotH}`);
const growthExit = x((yMax / start) * corpora[0].pages);
const text = narrow ? "text-[12px]" : "text-[11px]";
// The last size sits at the right edge, so its label ends there; any label crowding the next one
// is left off, its point still drawn.
const axisLabels = corpora
  .map((c, i) => ({ at: x(c.pages), label: fmtAxis(roundPages(c.pages)), last: i === corpora.length - 1 }))
  .filter((l, i, all) => l.last || all[i + 1].at - l.at > 48);
---

<svg viewBox={`0 0 ${W} ${H}`} class={`h-auto w-full ${className ?? ""}`} role="img" aria-labelledby={`${id}-title ${id}-desc`}>
  <title id={`${id}-title`}>Time per action by workspace size</title>
  <desc id={`${id}-desc`}>
    {rows.map((r) => `${r.label}: ${corpora.map((c) => `${fmtMs(c.ops[r.op].ms)} ms at ${fmtPages(c.pages)} pages`).join(", ")}.`).join(" ")}
  </desc>
  <defs>
    <clipPath id={`${id}-plot`}><rect x={pad.left} y={pad.top} width={plotW} height={plotH} /></clipPath>
  </defs>

  {[0, 10, 20].map((t) => (
    <g>
      <line x1={pad.left} x2={pad.left + plotW} y1={y(t)} y2={y(t)} class="stroke-neutral-150 dark:stroke-neutral-800" stroke-width="1" />
      <text x={pad.left - 8} y={y(t) + 4} text-anchor="end" class={`fill-neutral-400 ${text} tabular-nums dark:fill-neutral-500`}>{t}</text>
    </g>
  ))}
  <text x={pad.left - 8} y={pad.top - 12} text-anchor="end" class={`fill-neutral-400 ${text} dark:fill-neutral-500`}>ms</text>

  {axisLabels.map((l) => (
    <text x={l.at} y={H - pad.bottom + 20} text-anchor={l.last ? "end" : "middle"} class={`fill-neutral-400 ${text} tabular-nums dark:fill-neutral-500`}>{l.label}</text>
  ))}
  <text x={pad.left + plotW / 2} y={H - 6} text-anchor="middle" class={`fill-neutral-400 ${text} dark:fill-neutral-500`}>pages in the workspace</text>

  <line x1={pad.left} x2={pad.left + plotW} y1={y(FRAME_MS)} y2={y(FRAME_MS)} class="stroke-warning-400" stroke-width="1.5" stroke-dasharray="2 4" stroke-linecap="round" />
  <text x={pad.left + plotW} y={y(FRAME_MS) - 8} text-anchor="end" class={`fill-warning-600 ${text} font-medium dark:fill-warning-400`}>one screen refresh, 16.7 ms</text>

  <polyline points={growth.join(" ")} clip-path={`url(#${id}-plot)`} fill="none" class="stroke-neutral-400 dark:stroke-neutral-500" stroke-width="1.5" stroke-dasharray="5 5" />
  <text x={growthExit + 8} y={pad.top + 10} class={`fill-neutral-500 ${text} dark:fill-neutral-400`}>if it slowed as it filled</text>

  <polygon points={band} class="fill-primary-500/25 dark:fill-primary-400/25" />
  <polyline points={bandTop.join(" ")} fill="none" class="stroke-primary-500 dark:stroke-primary-400" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
  {corpora.map((c) => <circle cx={x(c.pages)} cy={y(slowest(c))} r="4" class="fill-primary-500 dark:fill-primary-400" />)}
  {bandLabel.map((line, i) => (
    <text x={pad.left + plotW} y={y(bandCeiling) - 12 - (bandLabel.length - 1 - i) * 16} text-anchor="end" class="fill-primary-600 text-[12px] font-semibold dark:fill-primary-300">{line}</text>
  ))}
</svg>
