---
import { type Series, fmtPages, fmtTime } from "../lib/speed";

interface Props {
  /** The workspace sizes, as seeded, one per row. */
  sizes: number[];
  series: Series[];
}

const { series, sizes } = Astro.props;
const mostPages = Math.max(...sizes);

// Class names are written out whole so Tailwind finds them: each action shows only while it's picked.
const SHOWN = [
  "hidden group-data-[action=a0]:flex",
  "hidden group-data-[action=a1]:flex",
  "hidden group-data-[action=a2]:flex",
  "hidden group-data-[action=a3]:flex",
  "hidden group-data-[action=a4]:flex",
];
const actions = series.slice(0, SHOWN.length).map((s, i) => {
  // Each action's bar is scaled to twice its own slowest median, so a time that doesn't grow draws
  // the same half-bar at every size and one that does fills out.
  const scale = 2 * Math.max(...s.values.map((v) => v?.ms ?? 0)) || 1;
  return { ...s, value: `a${i}`, shown: SHOWN[i], scale };
});
---

<div class="group" data-switch="action" data-action="a0">
  <div class="mb-6 flex justify-end">
    <div class="inline-flex flex-wrap rounded-lg border border-neutral-200 p-0.5 text-xs font-medium dark:border-neutral-800">
      {actions.map((a, i) => (
        <button type="button" data-switch-value={a.value} aria-pressed={i === 0 ? "true" : "false"} class="rounded-md px-3 py-1.5 text-neutral-500 transition-colors hover:text-neutral-900 aria-pressed:bg-neutral-900 aria-pressed:text-white dark:text-neutral-400 dark:hover:text-neutral-100 dark:aria-pressed:bg-neutral-100 dark:aria-pressed:text-neutral-900">{a.button}</button>
      ))}
    </div>
  </div>

  <div class="space-y-5">
    <div class="hidden grid-cols-[6rem_1fr_11rem] gap-x-6 text-xs font-medium text-neutral-400 sm:grid dark:text-neutral-500">
      <div>Pages</div>
      <div>How full the workspace is</div>
      <div>{actions.map((a) => <span class={a.shown}>{a.heading}</span>)}</div>
    </div>

    {sizes.map((pages, row) => (
      <div class="grid grid-cols-[1fr_auto] items-center gap-x-6 gap-y-2 sm:grid-cols-[6rem_1fr_11rem]">
        <div class="text-sm font-semibold text-neutral-900 tabular-nums dark:text-neutral-50">{fmtPages(pages)}</div>
        <div class="order-last col-span-2 h-3 rounded-full bg-neutral-100 sm:order-none sm:col-span-1 dark:bg-neutral-800">
          <div class="h-3 rounded-full bg-neutral-400 dark:bg-neutral-500" style={`width: ${Math.max(0.6, (pages / mostPages) * 100)}%`}></div>
        </div>
        <div>
          {actions.map((a) => {
            const v = a.values[row];
            return (
              <div class={`${a.shown} items-center gap-3`}>
                <div class="hidden h-3 w-20 shrink-0 rounded-full bg-neutral-100 sm:block dark:bg-neutral-800">
                  {v && <div class="h-3 rounded-full bg-primary-500 dark:bg-primary-400" style={`width: ${Math.max(3, Math.min(100, (v.ms / a.scale) * 100))}%`}></div>}
                </div>
                <span class="whitespace-nowrap text-sm font-semibold text-primary-600 tabular-nums dark:text-primary-300">{v ? fmtTime(v.ms) : "–"}</span>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</div>
