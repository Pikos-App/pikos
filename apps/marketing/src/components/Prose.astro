---
/**
 * Body copy for a page built on Base.astro.
 *
 * Astro scopes a component's <style> to that component, so a page that writes bare <h2> and <p>
 * inside a `prose` div gets no styling unless the rules sit in the same file. That is why several
 * pages carry an identical style block. This holds it once; new pages use this instead of copying
 * it again. BlogPost.astro keeps its own, because its prose is a slot inside a layout.
 */
interface Props {
  class?: string;
}

const { class: extra = "" } = Astro.props;
---

<div class:list={["prose text-base leading-relaxed text-neutral-600 dark:text-neutral-300", extra]}>
  <slot />
</div>

<style>
  /* A heading belongs to the text under it, so it takes its space above and gives almost none
     below. Equal gaps on both sides read as one undifferentiated column. */
  .prose :global(h2) {
    margin-top: 2.75rem;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-neutral-900);
  }
  :global(html.dark) .prose :global(h2) {
    color: var(--color-neutral-100);
  }

  .prose :global(p) {
    margin-top: 1.25rem;
  }

  .prose :global(h2 + p),
  .prose :global(h2 + ul) {
    margin-top: 0.625rem;
  }

  /* The wrapper's own top margin already spaces it from the lede. */
  .prose :global(h2:first-child),
  .prose :global(p:first-child) {
    margin-top: 0;
  }

  .prose :global(ul) {
    margin-top: 1rem;
    padding-left: 1.25rem;
    list-style-type: disc;
  }

  .prose :global(ul ul) {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    list-style-type: circle;
  }

  .prose :global(li) {
    margin-top: 0.375rem;
  }

  .prose :global(a) {
    color: var(--color-primary-500);
  }
  :global(html.dark) .prose :global(a) {
    color: var(--color-primary-400);
  }
  .prose :global(a:hover) {
    text-decoration: underline;
  }

  .prose :global(code) {
    border-radius: 0.25rem;
    background-color: var(--color-neutral-150);
    padding: 0.125rem 0.375rem;
    font-size: 0.875rem;
  }
  :global(html.dark) .prose :global(code) {
    background-color: var(--color-neutral-800);
  }
</style>
