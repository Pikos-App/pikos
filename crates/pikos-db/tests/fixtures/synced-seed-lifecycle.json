            "calendar": "Personal",
            "syncState": "detached",
            "rrule": "FREQ=WEEKLY",
            "untilDay": 21,
            "untilTime": "113000",
            "ruleZone": "$device",
            "base": {
              "start": { "day": 0, "time": "06:00" },
              "end": { "day": 0, "time": "06:30" }
            },
            "head": { "start": { "day": 0, "time": "06:00" }, "end": { "day": 0, "time": "06:30" } }
          },
          {
            "title": "Detached sprint",
            "calendar": "Work",
            "syncState": "detached",
            "rrule": "FREQ=WEEKLY",
            "ruleZone": "$device",
            "base": {
              "start": { "day": 0, "time": "07:15" },
              "end": { "day": 0, "time": "07:45" }
