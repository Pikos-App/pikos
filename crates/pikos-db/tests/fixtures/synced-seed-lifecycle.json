    {
      "name": "every recurring shape, with its head, occurrence deltas and connect day",
      "steps": [{ "op": "seed" }],
      "expect": {
        "series": [
          {
            "title": "Weekly 1:1 (London)",
            "calendar": "Personal",
            "syncState": "active",
            "rrule": "FREQ=WEEKLY",
            "ruleZone": "Europe/London",
            "base": {
