{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "seeds/**", "tsconfig*.json", "vitest.config.ts", "package.json"]
    },
    "lint": {
      "inputs": ["src/**", "seeds/**", "package.json"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "seeds/**", "vitest.config.ts", "tsconfig*.json", "package.json"]
    }
  }
}
