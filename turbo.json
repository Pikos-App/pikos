{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.js",
    "crates/pikos-db/tests/fixtures/**",
    "crates/pikos-recurrence/tests/fixtures/**",
    "apps/marketing/src/content/release-notes/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    // Holds no script. Each package's node hashes its own files, and chaining it through `^`
    // makes a task's hash include every workspace package it imports, without making it wait
    // for their tasks: `^test` did both, and so ran the test suites one package at a time.
    "transit": {
      "dependsOn": ["^transit"]
    },
    // A cached pass is replayed only when nothing the check reads has changed, so these take
    // every file in the package, as the scripts do: desktop's typecheck and lint also cover
    // e2e/, scripts/ and bridge/, and one of its unit tests reads src-tauri/capabilities. Docs
    // and the Rust source are left out because no TypeScript check reads them.
    "typecheck": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!src-tauri/src/**"]
    },
    "lint": {
      // Type-aware rules read the imported packages' types.
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!src-tauri/src/**"]
    },
    "test": {
      "dependsOn": ["^transit"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!src-tauri/src/**"]
    }
  }
}
